# Local configuration template. Keep real credentials out of version control.
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=1800

# Optional per-agent model overrides.
QG_MODEL_PLANNER=deepseek-v4-flash
QG_MODEL_COGNITIVE_DIFFICULTY=deepseek-v4-flash
QG_MODEL_ANSWER_DISTRACTOR=deepseek-v4-flash
QG_MODEL_WRITER=deepseek-v4-flash
QG_MODEL_VALIDATOR=deepseek-v4-flash
QG_MODEL_SOLVER=deepseek-v4-flash
QG_MODEL_DISTRACTOR_REVIEW=deepseek-v4-flash
QG_MODEL_COURSE_SCOPE_DISTRACTOR=deepseek-v4-flash
QG_REQUEST_TIMEOUT=1200
QG_ENABLE_COURSE_SCOPE_DISTRACTOR_REVIEW=true
