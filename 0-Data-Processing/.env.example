# Shared API configuration for every data-processing script.
# Copy this file to .env and fill in the real API key. Never commit .env.
# Qwen is used for MLR/DGL extraction, profiles, and prerequisite relations.
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.5-flash
QWEN_VISION_MODEL=qwen3.5-flash
QWEN_TIMEOUT_SECONDS=180

# DeepSeek is used by audit_and_revise_evidence.py and generate_profiles_v2.py.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=1800
